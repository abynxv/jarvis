# ==============================================================================
# JARVIS Environment Configuration
# ==============================================================================

# Primary LLM Provider: 'ollama', 'openai', 'anthropic', 'gemini'
LLM_PROVIDER=ollama

# Default model name
# For Ollama: 'llama3.2', 'mistral', 'qwen2.5:7b', etc.
# For OpenAI: 'gpt-4o-mini', 'gpt-4o'
# For Anthropic: 'claude-3-5-sonnet-20241022'
# For Gemini: 'gemini-1.5-flash', 'gemini-2.0-flash'
LLM_MODEL=llama3.2

# Ollama Settings (Local offline default)
OLLAMA_BASE_URL=http://localhost:11434

# Cloud LLM API Keys (optional if using local Ollama)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Search Engine Configuration
# Supported: 'duckduckgo' (free, no key needed) or 'tavily'
SEARCH_PROVIDER=duckduckgo
TAVILY_API_KEY=

# Storage & Paths
DATA_DIR=/home/abynxv/Projects/jarvis/data
SQLITE_DB_PATH=/home/abynxv/Projects/jarvis/data/jarvis.db

# Terminal Execution Safety
# 'true' enforces interactive confirmation before running state-modifying shell commands
REQUIRE_COMMAND_APPROVAL=true

# Voice Settings (Phase 4)
VOICE_ENABLED=false
STT_MODEL_SIZE=base.en
TTS_ENGINE=edge-tts
TTS_VOICE=en-US-ChristopherNeural
